{
  "name": "quiz",
  "main": "worker.js",
  "compatibility_date": "2026-08-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "outputs",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quiz-stats",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
